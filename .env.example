# Browser-safe public values from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
# Optional: the API falls back to VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only values. Never expose a service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
# Optional: the API falls back to VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated browser origins allowed to call the Node API.
API_ALLOWED_ORIGINS=http://localhost:8443

# Where the browser reaches the Node API (default http://localhost:3001/api).
# VITE_API_URL=http://localhost:3001/api

# ── Payments ────────────────────────────────────────────────────────────────
# Server-only secrets. NEVER prefix these with VITE_ (that would ship them to browsers).
# Service-role key: Supabase Dashboard → Project Settings → API keys (secret key).
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret your payment provider uses to sign webhooks (any long random string for now).
PAYMENTS_WEBHOOK_SECRET=
# true = show a "Simulate card payment" button that exercises the automatic flow.
PAYMENTS_TEST_MODE=false
# Same flag for the browser (only toggles the test button's visibility).
VITE_PAYMENTS_TEST_MODE=false

# ── Launch switches ─────────────────────────────────────────────────────────
# false = hide the built-in demo lots and demo artists (do this for a real launch).
SHOW_DEMO_LOTS=true

# ── Email (optional) ────────────────────────────────────────────────────────
# Notifications are always shown in the app. With these set, the API server also
# emails them (won, pay reminder, outbid, shipped, reserve decisions…) via Resend.
# Resend's free tier covers 3,000 emails/month (100/day) — plenty for a pilot.
# RESEND_API_KEY=re_...
# EMAIL_FROM=AURORA <hello@your-domain.ge>
# Public site address used in email links.
# APP_URL=https://your-domain.ge

# ── Push notifications (optional, and free) ─────────────────────────────────
# Browser push (the phone/desktop notification banner) costs nothing — no
# provider, no signup, no per-message fee. It works via a VAPID keypair you
# own. Generate one with `npx web-push generate-vapid-keys` (a working pair is
# already in your .env.local — see the setup notes sent alongside this file).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@aurora.ge
# Same public key, exposed to the browser so it can subscribe.
# VITE_VAPID_PUBLIC_KEY=
